datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String        @id @default(uuid())
  username           String        @unique
  email              String        @unique
  passwordHash       String
  pinHash            String // Hashed 4-digit PIN for manager approvals
  fullName           String
  role               String // "OWNER", "MANAGER", "CASHIER", "INVENTORY_CLERK"
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  auditLogs          AuditLog[]
  approvals          Approval[]    @relation("Approver")
  requestedApprovals Approval[]    @relation("Requester")
  sessions           UserSession[]
}

model Supplier {
  id            String           @id @default(uuid())
  name          String
  companyName   String?
  phone         String
  email         String?
  gstin         String? // GSTIN
  address       String?
  creditLimit   Float            @default(0.0)
  balance       Float            @default(0.0) // positive means we owe supplier
  purchases     PurchaseOrder[]
  ledgerEntries SupplierLedger[]
  isDeleted     Boolean          @default(false)
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  products      ProductSupplier[]
}

model Customer {
  id            String           @id @default(uuid())
  name          String
  phone         String           @unique
  email         String?
  gstin         String?
  address       String?
  creditLimit   Float            @default(0.0)
  balance       Float            @default(0.0) // positive means customer owes us
  priceLevel    String           @default("RETAIL") // "RETAIL", "WHOLESALE", "CONTRACTOR", "DISTRIBUTOR"
  bills         Bill[]
  ledgerEntries CustomerLedger[]
  isDeleted     Boolean          @default(false)
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Product {
  id               String               @id @default(uuid())
  sku              String               @unique
  barcode          String?              @unique
  name             String
  description      String?
  rackLocation     String?
  minimumProfitPct Float                @default(10.0)
  hsnCode          String? // HSN Code for GST reporting
  cgstRate         Float                @default(0.0)
  sgstRate         Float                @default(0.0)
  igstRate         Float                @default(0.0)

  // New pricing engine fields
  mrp            Float?
  level1Price    Float  @default(0.0) // Ideal Selling Price
  level2Price    Float  @default(0.0) // Biller Default Selling Price
  level3Price    Float  @default(0.0) // Minimum Selling Price
  emergencyPrice Float  @default(0.0) // Emergency Price limit

  categoryId         String?
  category           Category?            @relation(fields: [categoryId], references: [id])
  aliases            ProductAlias[]
  variants           ProductVariant[]
  images             ProductImage[]
  baseUnitId         String
  baseUnit           Unit                 @relation(fields: [baseUnitId], references: [id])
  priceLevels        ProductPrice[]
  purchaseItems      PurchaseItem[]
  billItems          BillItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  SalesReturnItem    SalesReturnItem[]
  PurchaseReturnItem PurchaseReturnItem[]
  fieldValues        ProductFieldValue[]
  primaryRelations   ProductRelationship[] @relation("PrimaryProduct")
  relatedRelations   ProductRelationship[] @relation("RelatedProduct")
  documents          ProductDocument[]
  suppliers          ProductSupplier[]
  stockLevels        StockLevel[]
  isDeleted          Boolean              @default(false)
  deletedAt          DateTime?

  @@index([name])
}

model Category {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  products    Product[]
  fields      CategoryField[]
  templates   ProductTemplate[]
  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
}

model CategoryField {
  id          String              @id @default(uuid())
  categoryId  String
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  type        String              // "STRING", "NUMBER", "BOOLEAN"
  isRequired  Boolean             @default(false)
  values      ProductFieldValue[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProductFieldValue {
  id              String        @id @default(uuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryFieldId String
  categoryField   CategoryField @relation(fields: [categoryFieldId], references: [id], onDelete: Cascade)
  value           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([productId, categoryFieldId])
  @@index([productId])
}

model ProductRelationship {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation("PrimaryProduct", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product  @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)
  type             String   // "COMPATIBLE", "ALTERNATIVE", "ACCESSORY", "BOUGHT_TOGETHER", "CROSS_SELL", "UPSELL"
  createdAt        DateTime @default(now())

  @@unique([productId, relatedProductId, type])
  @@index([productId])
}

model ProductDocument {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String   // "WARRANTY", "DATASHEET", "MANUAL", "CERTIFICATE", "INVOICE"
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProductSupplier {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, supplierId])
}

model ProductTemplate {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String?
  cgstRate         Float    @default(0.0)
  sgstRate         Float    @default(0.0)
  igstRate         Float    @default(0.0)
  minimumProfitPct Float    @default(10.0)
  baseUnitId       String
  baseUnit         Unit     @relation(fields: [baseUnitId], references: [id])
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  createdAt        DateTime @default(now())
}

model Warehouse {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String       @unique // e.g. WH-001
  address     String?
  stockLevels StockLevel[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model StockLevel {
  id            String             @id @default(uuid())
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity      Float              @default(0.0)
  minStockLevel Float              @default(0.0)
  costPrice     Float              @default(0.0)
  version       Int                @default(0)
  history       InventoryHistory[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryHistory {
  id              String     @id @default(uuid())
  stockLevelId    String
  stockLevel      StockLevel @relation(fields: [stockLevelId], references: [id], onDelete: Cascade)
  type            String // "PURCHASE", "SALE", "RETURN", "ADJUSTMENT", "RECONCILIATION"
  quantityChanged Float
  balanceQuantity Float
  costPrice       Float
  referenceId     String?
  userId          String
  createdAt       DateTime   @default(now())
}

model ProductAlias {
  id        String  @id @default(uuid())
  aliasName String  @unique
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Unit {
  id            String            @id @default(uuid())
  name          String            @unique
  abbreviation  String            @unique
  conversions   UnitConversion[]  @relation("FromUnit")
  toConversions UnitConversion[]  @relation("ToUnit")
  products      Product[]
  templates     ProductTemplate[]
}

model UnitConversion {
  id         String @id @default(uuid())
  fromUnitId String
  toUnitId   String
  factor     Float
  fromUnit   Unit   @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit   @relation("ToUnit", fields: [toUnitId], references: [id])
}

model ProductPrice {
  id        String  @id @default(uuid())
  productId String
  level     String // "RETAIL", "WHOLESALE", "CONTRACTOR", "DISTRIBUTOR"
  price     Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, level])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  name      String
  sku       String  @unique
  barcode   String? @unique
  price     Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Bill {
  id             String           @id @default(uuid())
  billNumber     String           @unique
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  totalAmount    Float
  discountAmount Float            @default(0.0)
  cgstAmount     Float            @default(0.0)
  sgstAmount     Float            @default(0.0)
  igstAmount     Float            @default(0.0)
  netAmount      Float
  paidAmount     Float            @default(0.0)
  balanceAmount  Float            @default(0.0)
  paymentMethod  String           @default("CASH") // "CASH", "UPI", "CARD", "CREDIT"
  isQuote        Boolean          @default(false)
  userId         String
  status         String           @default("FINALIZED") // "FINALIZED", "PENDING_APPROVAL", "REJECTED", "DRAFT"
  clientRef      String?          @unique // idempotency key for bills created offline and synced later
  offlineCreatedAt DateTime? // when an offline bill was actually made at the counter
  createdAt      DateTime         @default(now())
  items          BillItem[]
  payments       PaymentSplit[]
  customerLedger CustomerLedger[]
  approvals      Approval[]
  salesReturns   SalesReturn[]

  @@index([billNumber])
  @@index([createdAt])
}

model BillItem {
  id         String  @id @default(uuid())
  billId     String
  productId  String
  quantity   Float
  unitPrice  Float
  discount   Float   @default(0.0)
  cgstRate   Float   @default(0.0)
  cgstAmount Float   @default(0.0)
  sgstRate   Float   @default(0.0)
  sgstAmount Float   @default(0.0)
  igstRate   Float   @default(0.0)
  igstAmount Float   @default(0.0)
  totalPrice Float
  bill       Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
}

model PaymentSplit {
  id             String  @id @default(uuid())
  billId         String
  paymentMethod  String // "CASH", "UPI", "CARD", "CREDIT"
  amount         Float
  transactionRef String?
  bill           Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id              String           @id @default(uuid())
  poNumber        String           @unique
  supplierId      String
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  totalAmount     Float
  cgstAmount      Float            @default(0.0)
  sgstAmount      Float            @default(0.0)
  igstAmount      Float            @default(0.0)
  netAmount       Float
  paidAmount      Float            @default(0.0)
  balanceAmount   Float            @default(0.0)
  status          String           @default("ORDERED") // "ORDERED", "PARTIALLY_RECEIVED", "RECEIVED", "CANCELLED"
  supplierInvoiceNumber String?
  expectedDate    DateTime?
  receivedAt      DateTime?
  notes           String?
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  items           PurchaseItem[]
  supplierLedger  SupplierLedger[]
  purchaseReturns PurchaseReturn[]
}

model PurchaseItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Float
  receivedQuantity Float        @default(0.0)
  costPrice       Float
  cgstRate        Float         @default(0.0)
  cgstAmount      Float         @default(0.0)
  sgstRate        Float         @default(0.0)
  sgstAmount      Float         @default(0.0)
  igstRate        Float         @default(0.0)
  igstAmount      Float         @default(0.0)
  totalPrice      Float
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
}

model CustomerLedger {
  id              String       @id @default(uuid())
  customerId      String
  billId          String?
  transactionType String
  debit           Float        @default(0.0)
  credit          Float        @default(0.0)
  runningBalance  Float
  createdAt       DateTime     @default(now())
  customer        Customer     @relation(fields: [customerId], references: [id])
  bill            Bill?        @relation(fields: [billId], references: [id])
  salesReturnId   String?
  salesReturn     SalesReturn? @relation(fields: [salesReturnId], references: [id])

  @@index([customerId, createdAt])
}

model SupplierLedger {
  id               String          @id @default(uuid())
  supplierId       String
  purchaseOrderId  String?
  transactionType  String
  debit            Float           @default(0.0)
  credit           Float           @default(0.0)
  runningBalance   Float
  createdAt        DateTime        @default(now())
  supplier         Supplier        @relation(fields: [supplierId], references: [id])
  purchaseOrder    PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  purchaseReturnId String?
  purchaseReturn   PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id])

  @@index([supplierId, createdAt])
}

model Approval {
  id            String   @id @default(uuid())
  requesterId   String
  approverId    String?
  module        String
  description   String
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  actionDetails String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  requester     User     @relation("Requester", fields: [requesterId], references: [id])
  approver      User?    @relation("Approver", fields: [approverId], references: [id])
  billId        String?
  bill          Bill?    @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PriceApprovalLog {
  id          String   @id @default(uuid())
  billNumber  String?
  productId   String
  productName String
  requestedBy String
  approvedBy  String
  oldPrice    Float
  newPrice    Float
  reason      String
  createdAt   DateTime @default(now())
}

model SalesReturn {
  id             String            @id @default(uuid())
  returnNumber   String            @unique
  billId         String
  bill           Bill              @relation(fields: [billId], references: [id])
  totalAmount    Float
  cgstAmount     Float             @default(0.0)
  sgstAmount     Float             @default(0.0)
  igstAmount     Float             @default(0.0)
  netAmount      Float
  status         String            @default("APPROVED") // "PENDING", "APPROVED", "REJECTED"
  userId         String
  reason         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          SalesReturnItem[]
  customerLedger CustomerLedger[]
}

model SalesReturnItem {
  id            String      @id @default(uuid())
  salesReturnId String
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Float
  unitPrice     Float
  refundAmount  Float
  disposition   String      @default("RETURN_TO_STOCK") // "RETURN_TO_STOCK", "DAMAGED", "WARRANTY", "REJECTED"
  notes         String?
}

model PurchaseReturn {
  id              String               @id @default(uuid())
  returnNumber    String               @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  totalAmount     Float
  cgstAmount      Float                @default(0.0)
  sgstAmount      Float                @default(0.0)
  igstAmount      Float                @default(0.0)
  netAmount       Float
  status          String               @default("APPROVED") // "PENDING", "APPROVED", "REJECTED"
  userId          String
  reason          String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           PurchaseReturnItem[]
  supplierLedger  SupplierLedger[]
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Float
  costPrice        Float
  refundAmount     Float
  notes            String?
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
}

model DaySession {
  id               String                  @id @default(uuid())
  openingUser      String
  openingTime      DateTime                @default(now())
  openingCash      Float
  openingCard      Float
  openingUpi       Float
  openingNotes     String?
  closingTime      DateTime?
  expectedCash     Float?
  actualCash       Float?
  difference       Float?
  closingNotes     String?
  status           String                  @default("OPEN") // "OPEN", "CLOSED", "PENDING_APPROVAL"
  aiSummary        String?
  cashTransactions CashDrawerTransaction[]
}

model CashDrawerTransaction {
  id           String     @id @default(uuid())
  sessionId    String
  daySession   DaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type         String     // "IN", "OUT", "DEPOSIT", "WITHDRAWAL", "EXPENSE", "SALE"
  amount       Float
  referenceId  String?    // e.g. Bill ID or Expense ID
  notes        String?
  createdAt    DateTime   @default(now())
}

model Expense {
  id           String   @id @default(uuid())
  category     String   // "ELECTRICITY", "FUEL", "TRANSPORT", "SALARY", "RENT", "TEA", "MAINTENANCE", "CUSTOM"
  amount       Float
  notes        String?
  isApproved   Boolean  @default(true)
  approvedBy   String?
  attachmentUrl String?
  isRecurring  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Reminder {
  id          String   @id @default(uuid())
  title       String
  type        String   // "CUSTOMER_DUE", "SUPPLIER_DUE", "GST", "LICENSE", "WARRANTY", "INSURANCE", "CUSTOM"
  dueDate     DateTime
  status      String   @default("PENDING") // "PENDING", "DISMISSED"
  priority    String   @default("MEDIUM") // "HIGH", "MEDIUM", "LOW"
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AiCostLog {
  id               String   @id @default(uuid())
  provider         String
  model            String
  taskType         String   // "OCR", "REASONING", "AUTOCOMPLETE"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  estimatedCost    Float    @default(0.0)
  createdAt        DateTime @default(now())
}

model Attachment {
  id         String   @id @default(uuid())
  name       String
  url        String
  type       String   // "PDF", "IMAGE", "DOC"
  productId  String?
  customerId String?
  supplierId String?
  billId     String?
  expenseId  String?
  createdAt  DateTime @default(now())
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// ==========================================
// AI Agent: conversations, guarded actions, knowledge base (RAG)
// ==========================================

model AgentConversation {
  id        String         @id @default(uuid())
  userId    String
  title     String         @default("New conversation")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]
  actions   AgentAction[]

  @@index([userId, updatedAt])
}

model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user", "assistant", "tool"
  content        String            @default("")
  toolCalls      String? // JSON array of {id, name, arguments} requested by the assistant
  toolCallId     String? // for role "tool": which call this result answers
  toolName       String?
  citations      String? // JSON array of {n, title, documentId}
  uiActions      String? // JSON array of client-side actions emitted with this message
  feedback       Int? // 1 = helpful, -1 = not helpful
  provider       String?
  model          String?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

model AgentAction {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  toolName       String
  toolCallId     String
  args           String // JSON, frozen at proposal time; exactly this is executed on confirm
  summary        String
  details        String? // JSON array of {label, value} shown on the confirmation card
  status         String            @default("PENDING") // "PENDING", "EXECUTED", "REJECTED", "FAILED", "EXPIRED"
  result         String?
  error          String?
  expiresAt      DateTime
  decidedAt      DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId, status])
}

model KnowledgeDocument {
  id          String           @id @default(uuid())
  title       String
  category    String           @default("GENERAL") // "POLICY", "GUIDE", "FAQ", "GENERAL", "PRODUCT"
  source      String           @default("MANUAL") // "MANUAL", "SYSTEM", "PRODUCT"
  sourceId    String?          @unique // e.g. product id for catalog documents
  content     String
  contentHash String
  isActive    Boolean          @default(true)
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chunks      KnowledgeChunk[]

  @@index([source])
}

model KnowledgeChunk {
  id             String            @id @default(uuid())
  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal        Int
  text           String
  embedding      String? // JSON number[]; null when embedding failed (keyword search still works)
  embeddingModel String?
  createdAt      DateTime          @default(now())

  @@index([documentId])
}

model AgentEvalRun {
  id         String    @id @default(uuid())
  startedBy  String
  status     String    @default("RUNNING") // "RUNNING", "COMPLETED", "FAILED"
  total      Int       @default(0)
  passed     Int       @default(0)
  results    String    @default("[]") // JSON array of per-case results
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
}
